{
  // Re-resolve the classpath automatically whenever build.gradle changes.
  "java.configuration.updateBuildConfiguration": "automatic",

  // Treat this folder as a Gradle project so the NeoForge dependency
  // (and the userdev-generated Minecraft jars) land on the classpath.
  "java.import.gradle.enabled": true,
  "java.import.gradle.wrapper.enabled": true,

  // CRITICAL: VSCode is a GUI app and does NOT inherit the terminal's
  // JAVA_HOME/PATH. Without an explicit JVM, the Gradle extension cannot launch
  // Gradle to compute the classpath, so every net.* / com.mojang.* import stays
  // unresolved. Pin a JDK that Gradle 9.2.1 supports (JDK 25 is what the build
  // toolchain uses; foojay already downloaded it).
  "java.import.gradle.java.home": "/Users/kdxiaoyi/.gradle/jdks/eclipse_adoptium-25-aarch64-os_x.2/jdk-25.0.4+7/Contents/Home",

  // Make the editor (JDT LS) use a real JDK so it can resolve the Java 25 APIs
  // that NeoForge 26.2 targets. JavaSE-26 is the user's preferred editing JDK.
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-26",
      "path": "/opt/homebrew/opt/openjdk@26",
      "default": true
    },
    {
      "name": "JavaSE-25",
      "path": "/Users/kdxiaoyi/.gradle/jdks/eclipse_adoptium-25-aarch64-os_x.2/jdk-25.0.4+7/Contents/Home"
    },
    {
      "name": "JavaSE-24",
      "path": "/Library/Java/JavaVirtualMachines/jdk-24.jdk/Contents/Home"
    }
  ],

  // Make sure the editor sees both hand-written and datagen-produced sources.
  "java.project.sourcePaths": [
    "src/main/java",
    "src/generated/resources"
  ]
}
